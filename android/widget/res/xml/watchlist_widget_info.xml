<?xml version="1.0" encoding="utf-8"?>
<!-- The grid scrolls vertically and the column count follows the width, so the widget
     resizes freely in both directions. description, previewLayout and widgetFeatures are
     ignored below their API levels. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="app.cuenext.pinya.widget.WidgetConfigActivity"
    android:description="@string/widgetDescription"
    android:initialLayout="@layout/widget_watchlist_2col"
    android:minHeight="180dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_watchlist_2col"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
