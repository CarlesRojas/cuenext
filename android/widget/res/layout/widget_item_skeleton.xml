<?xml version="1.0" encoding="utf-8"?>
<!-- A loading cell: the same rounded 2:3 gray card as a poster (the placeholder bitmap
     drives the size), pulsing via a ViewFlipper that fades a soft highlight in and out.
     RemoteViews can't run property animations, but flippers auto-start in the launcher. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/skeleton_poster"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widgetPosterDescription"
        android:scaleType="fitXY" />

    <ViewFlipper
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="700"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_skeleton_highlight" />
    </ViewFlipper>
</FrameLayout>
