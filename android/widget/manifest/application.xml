        <!-- cuenext-widget:components:begin -->
        <!-- Home-screen watchlist widget. Injected into the generated manifest by
             apply-widget.sh after every `bubblewrap update`. -->
        <receiver
            android:name="app.cuenext.pinya.widget.WatchlistWidgetProvider"
            android:exported="false"
            android:label="@string/widgetName">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/watchlist_widget_info" />
        </receiver>

        <activity
            android:name="app.cuenext.pinya.widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name="app.cuenext.pinya.widget.WidgetGridService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Serves the pre-rendered poster cards to the launcher by content URI, which
             keeps the grid's RemoteViews under the launcher's bitmap-memory cache cap.
             Exported by necessity (collection RemoteViews have no grant mechanism); it
             only serves public TMDB artwork under salted unguessable names. -->
        <provider
            android:name="app.cuenext.pinya.widget.WidgetPosterProvider"
            android:authorities="app.cuenext.pinya.widgetposters"
            android:exported="true" />

        <activity
            android:name="app.cuenext.pinya.widget.WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name="app.cuenext.pinya.widget.WidgetTokenActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="widget-setup"
                    android:scheme="cuenext" />
            </intent-filter>
        </activity>
        <!-- cuenext-widget:components:end -->
