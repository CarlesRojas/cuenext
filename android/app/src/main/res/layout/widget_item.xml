<?xml version="1.0" encoding="utf-8"?>
<!-- One poster cell, the widget's PosterCard: rounded poster (the bitmap is pre-rounded
     by WidgetApi), the watch/rate corner button, and the watch-progress bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="96dp"
    android:layout_height="144dp"
    android:layout_marginEnd="8dp">

    <ImageView
        android:id="@+id/item_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widgetPosterDescription"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/item_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_cell_background"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="4"
        android:padding="8dp"
        android:textColor="#FF737373"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/item_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginStart="10dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_progress"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/item_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/widget_button_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="5dp"
        android:paddingEnd="7dp"
        android:paddingStart="7dp"
        android:paddingTop="5dp">

        <TextView
            android:id="@+id/item_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/item_button_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="@string/widgetButtonDescription" />
    </LinearLayout>
</FrameLayout>
