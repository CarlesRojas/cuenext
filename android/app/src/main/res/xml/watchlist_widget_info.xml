<?xml version="1.0" encoding="utf-8"?>
<!-- Sized so the default drop is one poster row (~2 launcher rows tall, 3-4 columns
     wide); horizontally resizable to fit more posters. description, previewLayout and
     widgetFeatures are ignored below their API levels. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="app.cuenext.pinya.widget.WidgetConfigActivity"
    android:description="@string/widgetDescription"
    android:initialLayout="@layout/widget_watchlist"
    android:minHeight="180dp"
    android:minResizeHeight="180dp"
    android:minResizeWidth="120dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_watchlist"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
