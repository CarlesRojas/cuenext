<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="app staging" type="AndroidRunConfigurationType" factoryName="Android App" activateToolWindowBeforeRun="true">
    <!-- DEV URL: edit the -d value in ACTIVITY_EXTRA_FLAGS below (or via Run > Edit
         Configurations > app staging > Launch Flags) to where this branch's app runs:

         - http://localhost:3000/ - local `pnpm dev` on a USB device; run
           `adb reverse tcp:3000 tcp:3000` first so the device reaches your machine.
         - http://10.0.2.2:3000/ - local `pnpm dev` on an emulator (10.0.2.2 is the
           host's localhost; no tunnel needed).
         - https://... - any deployed preview.

         Why this works: the flags are appended to the `am start` call Android Studio
         uses to launch the app, and the TWA's LauncherActivity opens the intent's data
         URL when one is present, falling back to the production launchUrl otherwise.
         Launch flags never enter the APK/AAB, and `bubblewrap build` doesn't read run
         configurations at all, so packaged releases always use the production URL from
         twa-manifest.json. -->
    <module name="android.app" />
    <option name="DEPLOY" value="true" />
    <option name="DEPLOY_APK_FROM_BUNDLE" value="false" />
    <option name="DEPLOY_AS_INSTANT" value="false" />
